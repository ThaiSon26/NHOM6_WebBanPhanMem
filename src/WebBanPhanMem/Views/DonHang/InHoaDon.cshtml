@model WebBanPhanMem.Models.Hoadon
@{
    Layout = null; // Không dùng _AdminLayout để in sạch sẽ
    var donHang = Model.DonHang;
    var chiTiets = donHang?.Chitietdonhangs.ToList() ?? new List<WebBanPhanMem.Models.Chitietdonhang>();

    decimal tienChuaThue = Math.Round(Model.SoTien / (1 + (Model.ThueSuat / 100m)), 0);
    decimal tienThue = Model.SoTien - tienChuaThue;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Hóa đơn điện tử - @Model.SoHoaDon</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #1e293b;
            padding: 30px;
        }
        .invoice-card {
            max-width: 820px;
            margin: 0 auto;
            background: #ffffff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            border: 1px solid #e2e8f0;
        }
        .invoice-header {
            border-bottom: 2px solid #2563eb;
            padding-bottom: 20px;
            margin-bottom: 24px;
        }
        .brand-logo {
            font-size: 24px;
            font-weight: 800;
            color: #2563eb;
            letter-spacing: -0.5px;
        }
        .font-mono {
            font-family: "JetBrains Mono", Consolas, monospace;
        }
        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .invoice-card {
                box-shadow: none;
                border: none;
                padding: 0;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="no-print text-center mb-3">
        <button class="btn btn-primary px-4 fw-semibold me-2" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> In Hóa Đơn (Ctrl + P)
        </button>
        <button class="btn btn-outline-secondary" onclick="window.close()">Đóng</button>
    </div>

    <div class="invoice-card">
        <!-- Header -->
        <div class="invoice-header d-flex justify-content-between align-items-start">
            <div>
                <div class="brand-logo"><i class="bi bi-layers-half me-1"></i>SOFTDEV STORE</div>
                <div class="small text-muted">Hệ thống phân phối bản quyền phần mềm chính hãng</div>
                <div class="small text-muted">Hotline: 1900 6868 · Email: hotro@softdev.vn</div>
            </div>
            <div class="text-end">
                <h3 class="fw-bold text-dark mb-0">HÓA ĐƠN ĐIỆN TỬ</h3>
                <div class="font-mono text-primary fw-bold fs-5">@Model.SoHoaDon</div>
                <div class="small text-muted">Ngày phát hành: @(Model.NgayPhatHanh.HasValue ? Model.NgayPhatHanh.Value.ToString("dd/MM/yyyy HH:mm") : Model.NgayTao.ToString("dd/MM/yyyy"))</div>
                <div class="small text-muted">Mã đơn gốc: <span class="font-mono text-dark fw-semibold">#@(donHang?.MaDonHang ?? "—")</span></div>
            </div>
        </div>

        <!-- Bên mua -->
        <div class="row mb-4">
            <div class="col-8">
                <div class="text-muted small fw-semibold text-uppercase mb-1">Đơn vị / Khách hàng mua:</div>
                <div class="fw-bold fs-6 text-dark">@Model.TenDonVi</div>
                @if (!string.IsNullOrEmpty(Model.MaSoThue))
                {
                    <div class="small">Mã số thuế: <strong class="font-mono">@Model.MaSoThue</strong></div>
                }
                @if (!string.IsNullOrEmpty(Model.DiaChi))
                {
                    <div class="small text-muted">Địa chỉ: @Model.DiaChi</div>
                }
                <div class="small text-muted">Email: @Model.Email</div>
            </div>
            <div class="col-4 text-end">
                <div class="text-muted small fw-semibold text-uppercase mb-1">Trạng thái:</div>
                <span class="badge bg-success-subtle text-success fs-6 border border-success-subtle px-3 py-1">
                    @Model.TrangThai
                </span>
            </div>
        </div>

        <!-- Bảng hàng hóa -->
        <table class="table table-bordered mb-4">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width: 40px;">#</th>
                    <th>Tên hàng hóa / Dịch vụ bản quyền</th>
                    <th class="text-center" style="width: 70px;">ĐVT</th>
                    <th class="text-center" style="width: 80px;">Số lượng</th>
                    <th class="text-end" style="width: 130px;">Đơn giá</th>
                    <th class="text-end" style="width: 140px;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var item in chiTiets)
                {
                    <tr>
                        <td class="text-center text-muted">@idx</td>
                        <td>
                            <div class="fw-semibold">@item.TenSanPham</div>
                        </td>
                        <td class="text-center">License</td>
                        <td class="text-center">@item.SoLuong</td>
                        <td class="text-end font-mono">@item.DonGia.ToString("N0")₫</td>
                        <td class="text-end font-mono fw-semibold">@item.ThanhTien.ToString("N0")₫</td>
                    </tr>
                    idx++;
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" class="text-end text-muted">Cộng tiền hàng (chưa VAT):</td>
                    <td class="text-end font-mono">@tienChuaThue.ToString("N0")₫</td>
                </tr>
                <tr>
                    <td colspan="5" class="text-end text-muted">Thuế suất GTGT (@Model.ThueSuat%):</td>
                    <td class="text-end font-mono">@tienThue.ToString("N0")₫</td>
                </tr>
                <tr class="table-light">
                    <td colspan="5" class="text-end fw-bold fs-6">TỔNG CỘNG TIỀN THANH TOÁN:</td>
                    <td class="text-end font-mono fw-bold text-primary fs-5">@Model.SoTien.ToString("N0")₫</td>
                </tr>
            </tfoot>
        </table>

        <!-- Chữ ký số -->
        <div class="row pt-3">
            <div class="col-6 text-center">
                <div class="fw-semibold text-muted">Người mua hàng</div>
                <div class="small text-muted fst-italic">(Ký, ghi rõ họ tên nếu có)</div>
            </div>
            <div class="col-6 text-center">
                <div class="fw-semibold text-muted">Đơn vị phát hành hóa đơn</div>
                <div class="small text-muted fst-italic">(Ký số điện tử)</div>
                <div class="mt-3 text-success fw-bold">
                    <i class="bi bi-shield-check me-1"></i>ĐÃ KÝ SỐ ĐIỆN TỬ
                </div>
            </div>
        </div>
    </div>
</body>
</html>

