@model List<WebBanPhanMem.Models.Doitac>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Đối tác";

    var allPartners = Model ?? new List<WebBanPhanMem.Models.Doitac>();
    int totalCount = allPartners.Count;
    int activeCount = allPartners.Count(p => p.ConHoatDong == true);
    int inactiveCount = totalCount - activeCount;
    int totalLinkedProducts = allPartners.Sum(p => p.Sanphams.Count);

    string searchTerm = ViewBag.SearchTerm as string ?? "";
    bool? selectedStatus = ViewBag.SelectedStatus as bool?;
}

<div class="admin-page-wrapper">
    <!-- Page Header -->
    <div class="page-header-bar">
        <div>
            <h1 class="page-title"><i class="bi bi-buildings-fill me-2 text-primary"></i>Quản lý Đối tác & Hãng phần mềm</h1>
            <p class="page-subtitle">Danh sách nhà phát hành, nhà phân phối bản quyền (Microsoft, Adobe, JetBrains,...)</p>
        </div>
        <button class="btn btn-primary btn-add" data-bs-toggle="modal" data-bs-target="#modalThemDoiTac">
            <i class="bi bi-plus-circle me-1"></i> Thêm đối tác mới
        </button>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bento-alert" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show bento-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bento Stats Row -->
    <div class="bento-stats-row">
        <div class="bento-stat-card">
            <div class="stat-icon bg-primary-soft">
                <i class="bi bi-buildings text-primary"></i>
            </div>
            <div>
                <div class="stat-value">@totalCount</div>
                <div class="stat-label">Tổng đối tác</div>
            </div>
        </div>

        <div class="bento-stat-card">
            <div class="stat-icon bg-success-soft">
                <i class="bi bi-patch-check-fill text-success"></i>
            </div>
            <div>
                <div class="stat-value">@activeCount</div>
                <div class="stat-label">Đang hợp tác</div>
            </div>
        </div>

        <div class="bento-stat-card">
            <div class="stat-icon bg-warning-soft">
                <i class="bi bi-pause-circle-fill text-warning"></i>
            </div>
            <div>
                <div class="stat-value">@inactiveCount</div>
                <div class="stat-label">Tạm ngưng</div>
            </div>
        </div>

        <div class="bento-stat-card">
            <div class="stat-icon bg-info-soft">
                <i class="bi bi-box-seam-fill text-info"></i>
            </div>
            <div>
                <div class="stat-value">@totalLinkedProducts</div>
                <div class="stat-label">Sản phẩm phân phối</div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bento-card filter-bar">
        <form method="get" action="@Url.Action("Index")" class="filter-form">
            <div class="filter-group">
                <div class="search-input-wrap">
                    <i class="bi bi-search search-icon-inner"></i>
                    <input type="text" name="search" class="form-control search-input"
                           placeholder="Tìm theo tên hãng, người liên hệ, email, SĐT..."
                           value="@searchTerm" />
                </div>
                <select name="conHoatDong" class="form-select filter-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="true" selected="@(selectedStatus == true)">Đang hợp tác</option>
                    <option value="false" selected="@(selectedStatus == false)">Tạm ngưng</option>
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Xóa lọc
                </a>
            </div>
        </form>
    </div>

    <!-- Partners Table -->
    <div class="bento-card table-card">
        <div class="table-responsive">
            <table class="table admin-table" id="doiTacTable">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Tên đối tác / Hãng</th>
                        <th>Đại diện liên hệ</th>
                        <th>Thông tin liên lạc</th>
                        <th>Ghi chú</th>
                        <th class="text-center">Số SP</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-center" style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!allPartners.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-building-slash fs-2 d-block mb-2"></i>
                                Chưa có đối tác nào. Nhấn <strong>Thêm đối tác mới</strong> để bắt đầu.
                            </td>
                        </tr>
                    }
                    @{ int idx = 1; }
                    @foreach (var dt in allPartners)
                    {
                        <tr>
                            <td class="text-muted">@idx</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="product-thumb-placeholder" style="width: 38px; height: 38px; font-size: 16px;">
                                        <i class="bi bi-building"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@dt.TenDoiTac</div>
                                        <small class="text-muted font-mono">ID: #@dt.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(dt.NguoiLienHe))
                                {
                                    <div class="fw-semibold text-dark"><i class="bi bi-person me-1 text-primary"></i>@dt.NguoiLienHe</div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(dt.Email))
                                {
                                    <div><i class="bi bi-envelope me-1 text-muted"></i><a href="mailto:@dt.Email" class="text-decoration-none">@dt.Email</a></div>
                                }
                                @if (!string.IsNullOrEmpty(dt.SoDienThoai))
                                {
                                    <div><i class="bi bi-telephone me-1 text-muted"></i><span class="font-mono">@dt.SoDienThoai</span></div>
                                }
                                @if (string.IsNullOrEmpty(dt.Email) && string.IsNullOrEmpty(dt.SoDienThoai))
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 180px;" title="@dt.GhiChu">
                                    @(string.IsNullOrEmpty(dt.GhiChu) ? "—" : dt.GhiChu)
                                </small>
                            </td>
                            <td class="text-center">
                                <span class="badge badge-package-link">
                                    <i class="bi bi-box me-1"></i>@dt.Sanphams.Count SP
                                </span>
                            </td>
                            <td>
                                <form asp-action="ToggleStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@dt.Id" />
                                    <button type="submit" class="btn-status @(dt.ConHoatDong == true ? "status-active" : "status-inactive")" title="Nhấn để đổi trạng thái">
                                        @(dt.ConHoatDong == true ? "Đang hợp tác" : "Tạm ngưng")
                                    </button>
                                </form>
                            </td>
                            <td>
                                <small class="text-muted">@dt.NgayTao.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                <div class="action-buttons justify-content-center">
                                    <button class="btn-action btn-edit" title="Chỉnh sửa đối tác"
                                            onclick="openEditDoiTacModal(@dt.Id, '@dt.TenDoiTac.Replace("'", "\\'")', '@(dt.NguoiLienHe?.Replace("'", "\\'") ?? "")', '@(dt.Email?.Replace("'", "\\'") ?? "")', '@(dt.SoDienThoai?.Replace("'", "\\'") ?? "")', '@(dt.GhiChu?.Replace("'", "\\'") ?? "")', @(dt.ConHoatDong == true ? "true" : "false"))">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn-action btn-delete" title="Xóa đối tác"
                                            onclick="confirmDeleteDoiTac(@dt.Id, '@dt.TenDoiTac.Replace("'", "\\'")')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        idx++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ===== Modal Thêm Đối Tác ===== -->
<div class="modal fade admin-modal" id="modalThemDoiTac" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Thêm đối tác / Hãng phần mềm mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold">Tên đối tác / Hãng phần mềm <span class="text-danger">*</span></label>
                            <input type="text" name="TenDoiTac" class="form-control" placeholder="VD: Microsoft Corporation, Adobe Inc." required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Người liên hệ / Đại diện</label>
                            <input type="text" name="NguoiLienHe" class="form-control" placeholder="VD: Nguyễn Văn A (Account Manager)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email liên hệ</label>
                            <input type="email" name="Email" class="form-control" placeholder="contact@partner.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại</label>
                            <input type="text" name="SoDienThoai" class="form-control" placeholder="VD: 0987654321" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Ghi chú chính sách / Hợp đồng</label>
                            <textarea name="GhiChu" class="form-control" rows="3" placeholder="Nhập ghi chú phân phối, điều khoản chiết khấu..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="ConHoatDong" value="true" id="chkDTHoatDong" checked>
                                <label class="form-check-label" for="chkDTHoatDong">
                                    <i class="bi bi-check-circle-fill text-success me-1"></i>Kích hoạt hợp tác ngay
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Thêm đối tác</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== Modal Sửa Đối Tác ===== -->
<div class="modal fade admin-modal" id="modalSuaDoiTac" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa thông tin đối tác</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editDTId" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold">Tên đối tác / Hãng <span class="text-danger">*</span></label>
                            <input type="text" name="TenDoiTac" id="editDTTen" class="form-control" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Người liên hệ</label>
                            <input type="text" name="NguoiLienHe" id="editDTNguoiLienHe" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email liên hệ</label>
                            <input type="email" name="Email" id="editDTEmail" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại</label>
                            <input type="text" name="SoDienThoai" id="editDTSDT" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Ghi chú</label>
                            <textarea name="GhiChu" id="editDTGhiChu" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="ConHoatDong" value="true" id="editDTHoatDong">
                                <label class="form-check-label" for="editDTHoatDong">
                                    <i class="bi bi-check-circle-fill text-success me-1"></i>Đang hợp tác
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== Modal Xóa Đối Tác ===== -->
<div class="modal fade admin-modal" id="modalXoaDoiTac" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p>Bạn có chắc chắn muốn xóa đối tác:</p>
                <p class="fw-bold text-dark" id="xoaDTTen"></p>
                <p class="text-danger small">⚠ Chỉ xóa được nếu đối tác chưa có sản phẩm hoặc kho key nào liên kết!</p>
            </div>
            <div class="modal-footer border-0">
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="xoaDTId" />
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i>Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditDoiTacModal(id, ten, nguoiLienHe, email, sdt, ghiChu, hoatDong) {
        document.getElementById('editDTId').value = id;
        document.getElementById('editDTTen').value = ten;
        document.getElementById('editDTNguoiLienHe').value = nguoiLienHe;
        document.getElementById('editDTEmail').value = email;
        document.getElementById('editDTSDT').value = sdt;
        document.getElementById('editDTGhiChu').value = ghiChu;
        document.getElementById('editDTHoatDong').checked = hoatDong;
        new bootstrap.Modal(document.getElementById('modalSuaDoiTac')).show();
    }

    function confirmDeleteDoiTac(id, ten) {
        document.getElementById('xoaDTId').value = id;
        document.getElementById('xoaDTTen').textContent = ten;
        new bootstrap.Modal(document.getElementById('modalXoaDoiTac')).show();
    }
</script>
}

