<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SoftDev Admin</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Chart.js for Bento Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Custom Bento Grid CSS (White + Blue + Clean SaaS + Developer Marketplace) -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-clean.css" asp-append-version="true" />
</head>

<body>
    <!-- MASTER APP CONTAINER (Clean Floating Bento Frame as in Screenshot) -->
    <div class="admin-app-container">

        <!-- SIDEBAR -->
        <aside class="admin-sidebar" id="adminSidebar">
            <!-- Sidebar Header with Dark Purple "Quản trị" Pill -->
            <div class="sidebar-header">
                <a href="/Admin" class="brand-pill" title="Trang quản trị SoftDev">
                    <div class="brand-pill-icon">
                        <i class="bi bi-layers-half"></i>
                    </div>
                    <span>Quản trị</span>
                </a>
                <button type="button" class="sidebar-toggle-btn" id="sidebarToggleBtn" title="Thu gọn/Mở rộng menu">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>

            <!-- Navigation Links -->
            <nav class="sidebar-nav">
                @{
                    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
                    bool isOverview = currentPath == "/admin" || currentPath == "/admin/index" || currentPath ==
                    "/admin/dashboard";
                    bool isDanhMuc = currentPath.Contains("danhmuc");
                    bool isDoiTac = currentPath.Contains("doitac");
                    bool isSanPham = currentPath.Contains("sanpham");
                    bool isKhoKey = currentPath.Contains("khokey");
                    bool isDonHang = currentPath.Contains("donhang");
                    bool isNguoiDung = currentPath.Contains("nguoidung") || currentPath.Contains("account");
                    bool isMarketing = currentPath.Contains("marketing") || currentPath.Contains("magiamgia") || currentPath.Contains("danhgia");
                    bool isThongKe = currentPath.Contains("thongke");
                    bool isCaiDat = currentPath.Contains("caidat");
                }

                <a href="/Admin" class="nav-link-item @(isOverview ? "active" : "")">
                    <div class="nav-link-item-left">
                        <i class="bi bi-grid-fill nav-icon"></i>
                        <span class="nav-text">Tổng quan</span>
                    </div>
                    <i class="bi bi-chevron-right nav-chevron"></i>
                </a>

                <a href="/Admin/DanhMuc" class="nav-link-item @(isDanhMuc ? "active" : "")">
                    <div class="nav-link-item-left">
                        <i class="bi bi-folder-fill nav-icon"></i>
                        <span class="nav-text">Danh mục</span>
                    </div>
                    <i class="bi bi-chevron-right nav-chevron"></i>
                </a>

                <a href="/Admin/DoiTac" class="nav-link-item @(isDoiTac ? "active" : "")">
                    <div class="nav-link-item-left">
                        <i class="bi bi-buildings-fill nav-icon"></i>
                        <span class="nav-text">Đối tác</span>
                    </div>
                    <i class="bi bi-chevron-right nav-chevron"></i>
                </a>

                <a href="/Admin/SanPham" class="nav-link-item @(isSanPham ? "active" : "")">
                    <div class="nav-link-item-left">
                        <i class="bi bi-box-seam-fill nav-icon"></i>
                        <span class="nav-text">Sản phẩm</span>
                    </div>
                    <i class="bi bi-chevron-right nav-chevron"></i>
                </a>

                <a href="/Admin/KhoKey" class="nav-link-item @(isKhoKey ? "active" : "")">
                    <div class="nav-link-item-left">
                        <i class="bi bi-key-fill nav-icon"></i>
                        <span class="nav-text">Kho License Key</span>
                    </div>
                    <i class="bi bi-chevron-right nav-chevron"></i>
                </a>

                <a href="/Admin/DonHang" class="nav-link-item @(isDonHang ? "active" : "")">
                    <div class="nav-link-item-left">
                        <i class="bi bi-receipt-cutoff nav-icon"></i>
                        <span class="nav-text">Đơn hàng</span>
                    </div>
                    <i class="bi bi-chevron-right nav-chevron"></i>
                </a>

                <a href="/Admin/NguoiDung" class="nav-link-item @(isNguoiDung ? "active" : "")">
                    <div class="nav-link-item-left">
                        <i class="bi bi-people-fill nav-icon"></i>
                        <span class="nav-text">Người dùng</span>
                    </div>
                    <i class="bi bi-chevron-right nav-chevron"></i>
                </a>

                <a href="/Admin/Marketing" class="nav-link-item @(isMarketing ? "active" : "")">
                    <div class="nav-link-item-left">
                        <i class="bi bi-megaphone-fill nav-icon"></i>
                        <span class="nav-text">Marketing & Review</span>
                    </div>
                    <i class="bi bi-chevron-right nav-chevron"></i>
                </a>

                <a href="#" class="nav-link-item @(isThongKe ? "active" : "")" title="Sắp ra mắt">
                    <div class="nav-link-item-left">
                        <i class="bi bi-bar-chart-line-fill nav-icon"></i>
                        <span class="nav-text">Thống kê</span>
                    </div>
                    <span class="nav-badge">Soon</span>
                </a>

                <a href="#" class="nav-link-item @(isCaiDat ? "active" : "")" title="Sắp ra mắt">
                    <div class="nav-link-item-left">
                        <i class="bi bi-gear-fill nav-icon"></i>
                        <span class="nav-text">Cài đặt</span>
                    </div>
                    <span class="nav-badge">Soon</span>
                </a>
            </nav>

            <!-- Sidebar Footer / Store Link -->
            <div class="sidebar-footer">
                <a href="/" class="nav-link-item text-primary" style="background: #eff6ff;">
                    <div class="nav-link-item-left">
                        <i class="bi bi-shop nav-icon text-primary"></i>
                        <span class="nav-text fw-bold">Xem Cửa Hàng</span>
                    </div>
                    <i class="bi bi-arrow-up-right nav-chevron text-primary"></i>
                </a>
            </div>
        </aside>

        <!-- MAIN VIEW AREA -->
        <main class="admin-content-area">
            <!-- Topbar (Title & Action Buttons from Screenshot) -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <!-- Nút thu/mở menu ngay trên Topbar -->
                    <button type="button" class="sidebar-toggle-topbar-btn" id="topbarSidebarToggleBtn"
                        title="Thu gọn / Mở rộng menu">
                        <i class="bi bi-layout-sidebar-inset"></i>
                    </button>
                    <h1 class="admin-page-title">@(ViewData["Title"] ?? "Bảng điều khiển quản trị")</h1>
                </div>

                <div class="topbar-actions">
                    <!-- Search Icon Button -->
                    <button class="action-icon-btn" id="topbarSearchBtn" title="Tìm kiếm">
                        <i class="bi bi-search"></i>
                    </button>

                    <!-- Purple Notification / Badge Button (from Screenshot) -->
                    <button class="action-icon-btn purple-btn" title="Thông báo hệ thống">
                        <i class="bi bi-bell"></i>
                    </button>

                    <!-- User / Arrow Action (from Screenshot) -->
                    <a href="/Admin" class="action-icon-btn" title="Chuyển hướng">
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <!-- User Profile Badge -->
                    <div class="user-profile-badge d-none d-sm-flex align-items-center">
                        <div class="user-avatar">
                            @{
                                string uName = User.Identity?.Name ?? "Admin";
                                string uInit = uName.Length >= 2 ? uName.Substring(0, 2).ToUpper() : "AD";
                            }
                            @uInit
                        </div>
                        <span class="ms-1">@uName</span>
                    </div>

                    <!-- Nút Đăng xuất -->
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="action-icon-btn text-danger" title="Đăng xuất khỏi hệ thống">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </header>

            <!-- Body View Container -->
            <section class="admin-body-container">
                @RenderBody()
            </section>
        </main>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/script.js" asp-append-version="true"></script>
    <script src="~/js/admin-toggle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
