@model List<WebBanPhanMem.Models.Khokey>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Kho License Key";

    var allKeys = Model ?? new List<WebBanPhanMem.Models.Khokey>();
    int totalCount = allKeys.Count;
    int availableCount = allKeys.Count(k => k.TrangThai == "Còn trống");
    int soldCount = allKeys.Count(k => k.TrangThai == "Đã bán");
    int errorCount = allKeys.Count(k => k.TrangThai == "Lỗi" || k.TrangThai == "Thu hồi");

    var goiList = ViewBag.GoiBanQuyenList as List<WebBanPhanMem.Models.Goibanquyen> ?? new();
    var doiTacList = ViewBag.DoiTacList as List<WebBanPhanMem.Models.Doitac> ?? new();
    var sanPhamList = ViewBag.SanPhamList as List<WebBanPhanMem.Models.Sanpham> ?? new();

    string searchTerm = ViewBag.SearchTerm as string ?? "";
    uint? selectedGoi = ViewBag.SelectedGoiId as uint?;
    uint? selectedDoiTac = ViewBag.SelectedDoiTacId as uint?;
    string selectedTrangThai = ViewBag.SelectedTrangThai as string ?? "";
}

<div class="admin-page-wrapper">
    <!-- Page Header -->
    <div class="page-header-bar">
        <div>
            <h1 class="page-title"><i class="bi bi-key-fill me-2 text-primary"></i>Quản lý Kho License Key</h1>
            <p class="page-subtitle">Quản lý mã kích hoạt bản quyền, xuất key tự động cho đơn hàng và nhập kho hàng loạt</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#modalBatchImport">
                <i class="bi bi-file-earmark-arrow-up me-1"></i> Nhập hàng loạt
            </button>
            <button class="btn btn-primary btn-add" data-bs-toggle="modal" data-bs-target="#modalThemKey">
                <i class="bi bi-plus-circle me-1"></i> Thêm 1 Key lẻ
            </button>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bento-alert" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show bento-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bento Stats Row -->
    <div class="bento-stats-row">
        <div class="bento-stat-card">
            <div class="stat-icon bg-primary-soft">
                <i class="bi bi-key text-primary"></i>
            </div>
            <div>
                <div class="stat-value">@totalCount</div>
                <div class="stat-label">Tổng số Key trong kho</div>
            </div>
        </div>

        <div class="bento-stat-card">
            <div class="stat-icon bg-success-soft">
                <i class="bi bi-check-all text-success"></i>
            </div>
            <div>
                <div class="stat-value">@availableCount</div>
                <div class="stat-label">Key còn trống (Sẵn sàng bán)</div>
            </div>
        </div>

        <div class="bento-stat-card">
            <div class="stat-icon bg-info-soft">
                <i class="bi bi-cart-check-fill text-info"></i>
            </div>
            <div>
                <div class="stat-value">@soldCount</div>
                <div class="stat-label">Key đã bán / Bàn giao</div>
            </div>
        </div>

        <div class="bento-stat-card">
            <div class="stat-icon bg-danger-soft">
                <i class="bi bi-shield-x text-danger"></i>
            </div>
            <div>
                <div class="stat-value">@errorCount</div>
                <div class="stat-label">Key lỗi / Thu hồi</div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bento-card filter-bar">
        <form method="get" action="@Url.Action("Index")" class="filter-form">
            <div class="filter-group">
                <div class="search-input-wrap">
                    <i class="bi bi-search search-icon-inner"></i>
                    <input type="text" name="search" class="form-control search-input"
                           placeholder="Tìm theo mã key, tên phần mềm, ghi chú..."
                           value="@searchTerm" />
                </div>
                <select name="goiId" class="form-select filter-select">
                    <option value="">-- Tất cả phần mềm & gói --</option>
                    @foreach (var g in goiList)
                    {
                        <option value="@g.Id" selected="@(selectedGoi == g.Id)">
                            @g.SanPham?.TenSanPham - @g.TenGoiBanQuyen
                        </option>
                    }
                </select>
                <select name="doiTacId" class="form-select filter-select">
                    <option value="">-- Mọi đối tác --</option>
                    @foreach (var dt in doiTacList)
                    {
                        <option value="@dt.Id" selected="@(selectedDoiTac == dt.Id)">@dt.TenDoiTac</option>
                    }
                </select>
                <select name="trangThai" class="form-select filter-select">
                    <option value="">-- Trạng thái key --</option>
                    <option value="Còn trống" selected="@(selectedTrangThai == "Còn trống")">Còn trống</option>
                    <option value="Đã bán" selected="@(selectedTrangThai == "Đã bán")">Đã bán</option>
                    <option value="Đã giữ chỗ" selected="@(selectedTrangThai == "Đã giữ chỗ")">Đã giữ chỗ</option>
                    <option value="Lỗi" selected="@(selectedTrangThai == "Lỗi")">Lỗi</option>
                    <option value="Thu hồi" selected="@(selectedTrangThai == "Thu hồi")">Thu hồi</option>
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Xóa lọc
                </a>
            </div>
        </form>
    </div>

    <!-- Key Table -->
    <div class="bento-card table-card">
        <div class="table-responsive">
            <table class="table admin-table" id="khoKeyTable">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Mã License Key</th>
                        <th>Phần mềm & Gói bản quyền</th>
                        <th>Loại Key</th>
                        <th>Đối tác cấp</th>
                        <th>Trạng thái</th>
                        <th>Thời điểm giao</th>
                        <th>Ngày nhập</th>
                        <th class="text-center" style="width: 130px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!allKeys.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-key fs-2 d-block mb-2"></i>
                                Kho key đang trống hoặc không có kết quả phù hợp. Hãy bấm <strong>Nhập hàng loạt</strong> hoặc <strong>Thêm 1 Key lẻ</strong>.
                            </td>
                        </tr>
                    }
                    @{ int idx = 1; }
                    @foreach (var k in allKeys)
                    {
                        <tr>
                            <td class="text-muted">@idx</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="font-mono fw-bold text-dark key-code-text">@k.MaKey</span>
                                    <button class="btn btn-sm btn-light border-0 py-0 px-1 text-muted" title="Sao chép Key" onclick="copyKey('@k.MaKey')">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                                @if (!string.IsNullOrEmpty(k.GhiChu))
                                {
                                    <small class="text-muted d-block text-truncate" style="max-width: 220px;" title="@k.GhiChu">
                                        <i class="bi bi-info-circle me-1"></i>@k.GhiChu
                                    </small>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@(k.GoiBanQuyen?.SanPham?.TenSanPham ?? "—")</div>
                                <small class="text-primary"><i class="bi bi-box me-1"></i>@(k.GoiBanQuyen?.TenGoiBanQuyen ?? "—")</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-mono">@k.LoaiKey</span>
                            </td>
                            <td>
                                <small class="text-muted">@(k.DoiTac?.TenDoiTac ?? "Tự nhập")</small>
                            </td>
                            <td>
                                @if (k.TrangThai == "Còn trống")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Còn trống
                                    </span>
                                }
                                else if (k.TrangThai == "Đã bán")
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        <i class="bi bi-bag-check me-1"></i>Đã bán
                                    </span>
                                }
                                else if (k.TrangThai == "Đã giữ chỗ")
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                        <i class="bi bi-clock-history me-1"></i>Đã giữ chỗ
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-exclamation-octagon me-1"></i>@k.TrangThai
                                    </span>
                                }
                            </td>
                            <td>
                                <small class="text-muted font-mono">
                                    @(k.ThoiDiemGiaoKey.HasValue ? k.ThoiDiemGiaoKey.Value.ToString("dd/MM/yyyy HH:mm") : "—")
                                </small>
                            </td>
                            <td>
                                <small class="text-muted font-mono">@k.NgayTao.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                <div class="action-buttons justify-content-center">
                                    <button class="btn-action btn-edit" title="Sửa thông tin key"
                                            onclick="openEditKeyModal(@k.Id, @k.GoiBanQuyenId, @(k.DoiTacId ?? 0), '@k.MaKey.Replace("'", "\\'")', '@k.LoaiKey', '@k.TrangThai', '@(k.GhiChu?.Replace("'", "\\'") ?? "")')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    @if (k.TrangThai != "Đã bán")
                                    {
                                        <button class="btn-action btn-delete" title="Xóa key này"
                                                onclick="confirmDeleteKey(@k.Id, '@k.MaKey.Replace("'", "\\'")')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                        idx++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ===== Modal Thêm 1 Key Lẻ ===== -->
<div class="modal fade admin-modal" id="modalThemKey" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Thêm License Key lẻ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-semibold mb-0">Gói bản quyền áp dụng <span class="text-danger">*</span></label>
                                <button type="button" class="btn btn-link p-0 text-decoration-none small fw-semibold" data-bs-toggle="modal" data-bs-target="#modalTaoNhanhGoi">
                                    <i class="bi bi-plus-circle me-1"></i>Tạo gói mới
                                </button>
                            </div>
                            @if (!goiList.Any())
                            {
                                <div class="alert alert-warning py-2 px-3 small rounded-3 mb-2">
                                    <i class="bi bi-exclamation-circle me-1"></i> Chưa có gói bản quyền nào trong CSDL! 
                                    <a href="javascript:void(0)" class="fw-bold text-dark ms-1" data-bs-toggle="modal" data-bs-target="#modalTaoNhanhGoi">Bấm vào đây để tạo nhanh gói</a>
                                </div>
                            }
                            <select name="GoiBanQuyenId" class="form-select" required>
                                <option value="">-- Chọn phần mềm & gói --</option>
                                @foreach (var g in goiList)
                                {
                                    <option value="@g.Id">@g.SanPham?.TenSanPham - @g.TenGoiBanQuyen</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Mã License Key / Kích hoạt <span class="text-danger">*</span></label>
                            <input type="text" name="MaKey" class="form-control font-mono" placeholder="VD: W269N-WFGWX-YVC9B-4J6C9-T83GX" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Loại Key</label>
                            <select name="LoaiKey" class="form-select">
                                <option value="Mã kích hoạt">Mã kích hoạt</option>
                                <option value="Tài khoản">Tài khoản</option>
                                <option value="Link tải">Link tải</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Nguồn đối tác</label>
                            <select name="DoiTacId" class="form-select">
                                <option value="0">-- Tự nhập / Trực tiếp --</option>
                                @foreach (var dt in doiTacList)
                                {
                                    <option value="@dt.Id">@dt.TenDoiTac</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Ghi chú bổ sung</label>
                            <input type="text" name="GhiChu" class="form-control" placeholder="VD: Batch tháng 11, bảo hành 12 tháng..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu vào kho</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== Modal Nhập Hàng Loạt (Batch Import) ===== -->
<div class="modal fade admin-modal" id="modalBatchImport" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-file-earmark-arrow-up me-2 text-primary"></i>Nhập License Key hàng loạt (Batch Paste)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="BatchImport" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-semibold mb-0">Gói bản quyền áp dụng <span class="text-danger">*</span></label>
                                <button type="button" class="btn btn-link p-0 text-decoration-none small fw-semibold" data-bs-toggle="modal" data-bs-target="#modalTaoNhanhGoi">
                                    <i class="bi bi-plus-circle me-1"></i>Tạo gói mới
                                </button>
                            </div>
                            <select name="goiBanQuyenId" class="form-select" required>
                                <option value="">-- Chọn gói bản quyền áp dụng --</option>
                                @foreach (var g in goiList)
                                {
                                    <option value="@g.Id">@g.SanPham?.TenSanPham - @g.TenGoiBanQuyen</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Loại Key</label>
                            <select name="loaiKey" class="form-select">
                                <option value="Mã kích hoạt">Mã kích hoạt</option>
                                <option value="Tài khoản">Tài khoản</option>
                                <option value="Link tải">Link tải</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Nguồn đối tác</label>
                            <select name="doiTacId" class="form-select">
                                <option value="0">-- Tự nhập --</option>
                                @foreach (var dt in doiTacList)
                                {
                                    <option value="@dt.Id">@dt.TenDoiTac</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Danh sách mã Key <span class="text-danger">*</span>
                                <small class="text-muted fw-normal">(Mỗi key nằm trên một dòng riêng biệt, hệ thống tự động loại bỏ trùng lặp)</small>
                            </label>
                            <textarea name="rawKeys" class="form-control font-mono" rows="8" placeholder="XXXXX-XXXXX-XXXXX-XXXXX-XXXX1&#10;XXXXX-XXXXX-XXXXX-XXXXX-XXXX2&#10;XXXXX-XXXXX-XXXXX-XXXXX-XXXX3" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Ghi chú chung</label>
                            <input type="text" name="ghiChu" class="form-control" placeholder="Ghi chú cho đợt nhập này..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-box-arrow-in-down me-1"></i>Tiến hành nhập kho</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== Modal Sửa Key ===== -->
<div class="modal fade admin-modal" id="modalSuaKey" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa License Key</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editKeyId" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Gói bản quyền áp dụng <span class="text-danger">*</span></label>
                            <select name="GoiBanQuyenId" id="editGoiId" class="form-select" required>
                                @foreach (var g in goiList)
                                {
                                    <option value="@g.Id">@g.SanPham?.TenSanPham - @g.TenGoiBanQuyen</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Mã Key <span class="text-danger">*</span></label>
                            <input type="text" name="MaKey" id="editMaKey" class="form-control font-mono" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Loại Key</label>
                            <select name="LoaiKey" id="editLoaiKey" class="form-select">
                                <option value="Mã kích hoạt">Mã kích hoạt</option>
                                <option value="Tài khoản">Tài khoản</option>
                                <option value="Link tải">Link tải</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Trạng thái Key</label>
                            <select name="TrangThai" id="editTrangThai" class="form-select">
                                <option value="Còn trống">Còn trống</option>
                                <option value="Đã bán">Đã bán</option>
                                <option value="Đã giữ chỗ">Đã giữ chỗ</option>
                                <option value="Lỗi">Lỗi</option>
                                <option value="Thu hồi">Thu hồi</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Nguồn đối tác</label>
                            <select name="DoiTacId" id="editKeyDoiTac" class="form-select">
                                <option value="0">-- Tự nhập --</option>
                                @foreach (var dt in doiTacList)
                                {
                                    <option value="@dt.Id">@dt.TenDoiTac</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Ghi chú</label>
                            <input type="text" name="GhiChu" id="editKeyGhiChu" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== Modal Xóa Key ===== -->
<div class="modal fade admin-modal" id="modalXoaKey" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p>Bạn có chắc muốn xóa mã key này khỏi kho?</p>
                <p class="fw-bold font-mono text-dark" id="xoaKeyText"></p>
                <small class="text-danger">Không thể hoàn tác hành động này!</small>
            </div>
            <div class="modal-footer border-0">
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="xoaKeyId" />
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i>Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ===== Modal Tạo Nhanh Gói Bản Quyền ===== -->
<div class="modal fade admin-modal" id="modalTaoNhanhGoi" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-box-seam me-2 text-primary"></i>Tạo nhanh Gói bản quyền</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateQuickGoi" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Thuộc Sản phẩm phần mềm nào <span class="text-danger">*</span></label>
                            @if (!sanPhamList.Any())
                            {
                                <div class="alert alert-warning py-2 px-3 small rounded-3 mb-2">
                                    <i class="bi bi-info-circle me-1"></i> Chưa có sản phẩm nào! Vui lòng vào menu <a href="/Admin/SanPham" class="fw-bold">Sản phẩm</a> tạo trước.
                                </div>
                            }
                            <select name="sanPhamId" class="form-select" required>
                                <option value="">-- Chọn phần mềm --</option>
                                @foreach (var sp in sanPhamList)
                                {
                                    <option value="@sp.Id">@sp.TenSanPham</option>
                                }
                            </select>
                        </div>
                        <div class="col-8">
                            <label class="form-label fw-semibold">Tên gói bản quyền <span class="text-danger">*</span></label>
                            <input type="text" name="tenGoi" class="form-control" placeholder="VD: 1 Năm / 1 PC, Vĩnh viễn..." required />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-semibold">Mã hàng (SKU)</label>
                            <input type="text" name="maHang" class="form-control font-mono" placeholder="VD: WIN11-PRO" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Giá bán (₫) <span class="text-danger">*</span></label>
                            <input type="number" name="gia" class="form-control" placeholder="350000" min="0" value="199000" required />
                        </div>
                        <div class="col-3">
                            <label class="form-label fw-semibold">Số máy</label>
                            <input type="number" name="soMay" class="form-control" value="1" min="1" required />
                        </div>
                        <div class="col-3">
                            <label class="form-label fw-semibold">Bảo hành (ngày)</label>
                            <input type="number" name="baoHanh" class="form-control" value="365" min="0" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Lưu gói</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function copyKey(text) {
        navigator.clipboard.writeText(text).then(() => {
            alert('Đã sao chép License Key vào Clipboard!');
        });
    }

    function openEditKeyModal(id, goiId, doiTacId, maKey, loaiKey, trangThai, ghiChu) {
        document.getElementById('editKeyId').value = id;
        document.getElementById('editMaKey').value = maKey;
        document.getElementById('editLoaiKey').value = loaiKey;
        document.getElementById('editTrangThai').value = trangThai;
        document.getElementById('editKeyGhiChu').value = ghiChu;

        const goiSelect = document.getElementById('editGoiId');
        for (let opt of goiSelect.options) {
            opt.selected = (opt.value == goiId);
        }

        const dtSelect = document.getElementById('editKeyDoiTac');
        for (let opt of dtSelect.options) {
            opt.selected = (opt.value == doiTacId);
        }

        new bootstrap.Modal(document.getElementById('modalSuaKey')).show();
    }

    function confirmDeleteKey(id, maKey) {
        document.getElementById('xoaKeyId').value = id;
        document.getElementById('xoaKeyText').textContent = maKey;
        new bootstrap.Modal(document.getElementById('modalXoaKey')).show();
    }
</script>
}

